{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug OpenPI",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/DEBUG/forward.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "justMyCode": false
        }
    ]
}